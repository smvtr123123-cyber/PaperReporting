# ─────────────────────────────────────────────
# 프론트엔드(빌드 시 주입, VITE_ 접두사 필수)
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ─────────────────────────────────────────────
# Netlify Functions (서버 전용 시크릿, 절대 노출 금지)
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...      # service_role 키 (서버에서만 사용)

# ── 번역/요약 프로바이더 (둘 중 하나만 설정하면 됨) ──
# 우선순위: GEMINI_API_KEY 가 있으면 Gemini 사용, 없으면 Anthropic 사용.

# (권장·무료) Gemini API 키 — Google AI Studio(aistudio.google.com/apikey)에서 무료 발급.
# ※ Gemini 앱 유료 구독(Advanced)과는 별개이며, 아래는 API 키입니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# (대체) Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Resend (이메일 발송)
RESEND_API_KEY=re_...
REPORT_FROM_EMAIL=reports@yourdomain.com   # Resend 에서 인증된 발신 주소 (테스트는 onboarding@resend.dev)

# OpenAlex API 키 (권장) — openalex.org/settings/api 에서 무료 발급.
# 2026-02-13 부터 API 키 필요. 없으면 익명 호출이라 부하 시 503 이 주기적으로 발생.
OPENALEX_API_KEY=
OPENALEX_MAILTO=you@example.com

# 수동 리포팅 트리거 보호용 (선택)
REPORT_TRIGGER_SECRET=change-me
